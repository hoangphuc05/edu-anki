# Server environment variables
# Copy this file to `.env` and adjust the values for your environment.
# Never commit a real `.env` file — it may contain secrets.

# --- Server ---
# Port the Express server listens on (default: 3000)
PORT=3000

# --- Database ---
# SQLite database file. Relative paths are resolved from server/prisma/.
# e.g. file:./dev.db  or  file:/absolute/path/to/db.sqlite
DATABASE_URL=file:./dev.db

# --- Authentication (JWT) ---
# REQUIRED in production. Use strong, unique random values.
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes (jsonwebtoken format, e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
